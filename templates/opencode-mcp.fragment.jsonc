// opencode.jsonc —— mcp.gbrain 片段模板
// 用法：把下面的 "gbrain" 块并入你 opencode.jsonc 顶层 "mcp" 对象内；
//      把 <你的用户名> 替换为实际 Windows 用户名（或直接运行 deploy.ps1，它会自动完成合并）。
// 注意：本文件是片段（不是一个完整 JSON），deploy.ps1 / tools\merge-mcp.mjs 会安全地把它并入你的配置。
"gbrain": {
  "type": "local",
  "command": [
    "C:\\Users\\<你的用户名>\\.bun\\bin\\gbrain.exe",
    "serve",
    "--surface",
    "starter"
  ],
  "enabled": true,
  "environment": {
    "GBRAIN_HOME": "C:\\Users\\<你的用户名>",
    "LLAMA_SERVER_BASE_URL": "http://127.0.0.1:18080/v1",
    "LLAMA_SERVER_RERANKER_BASE_URL": "http://127.0.0.1:18081/v1",
    "GBRAIN_QUERY_EMBED_TIMEOUT_MS": "30000"
  }
}
